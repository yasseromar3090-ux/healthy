<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="product_template_product_form_custom" model="ir.ui.view">
            <field name="name">product.template.product.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='standard_price']" position="attributes">
                    <attribute name="groups">hide_cost_price_product.hide_cost_price_custom</attribute>
                </xpath>
                                  <xpath expr="//label[@for='standard_price']" position="attributes">
                    <attribute name="groups">hide_cost_price_product.hide_cost_price_custom</attribute>
                </xpath>
            </field>
        </record>
        <!-- Inherit Form View to Modify it -->
        <record id="product_template_product_tree_custom" model="ir.ui.view">
            <field name="name">product.template.product.tree</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='standard_price']" position="attributes">
                    <attribute name="groups">hide_cost_price_product.hide_cost_price_custom</attribute>
                </xpath>

            </field>
        </record>

        <!-- Inherit Form View to Modify it -->
        <record id="product_product_form_custom" model="ir.ui.view">
            <field name="name">product.product.form</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='standard_price']" position="attributes">
                    <attribute name="groups">hide_cost_price_product.hide_cost_price_custom</attribute>
                </xpath>
                  <xpath expr="//label[@for='standard_price']" position="attributes">
                    <attribute name="groups">hide_cost_price_product.hide_cost_price_custom</attribute>
                </xpath>
            </field>
        </record>
        <record id="product_product_tree_custom" model="ir.ui.view">
            <field name="name">product.product.tree</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_product_tree_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='standard_price']" position="attributes">
                    <attribute name="groups">hide_cost_price_product.hide_cost_price_custom</attribute>
                </xpath>

            </field>
        </record>

    </data>
</odoo>