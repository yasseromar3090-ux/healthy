<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record id="view_users_form_inherit_export" model="ir.ui.view">
            <field name="name">res.users.form.export</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='access_rights']" position="after">
                    <page string="Export Access" groups="base.group_no_one">
                        <group>
                            <group string="Export Rights">
                                <field name="groups_id" widget="many2many_checkboxes" 
                                       domain="[('category_id', '=', %(hide_export_button.module_category_export)d)]"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
