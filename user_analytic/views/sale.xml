<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <template id="report_sales_order_template">
             <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <div class="page" dir="rtl" style="font-family: 'Cairo', sans-serif;">
                <!-- Header Section -->
                <div style="text-align: center; margin-bottom: 20px;">
                    <h2 style="font-size: 24px; font-weight: bold; color: #333; text-decoration: underline;">
                        إذن صرف بضاعة
                    </h2>
                </div>

                <!-- Details Section -->
                <div class="row" style="margin-bottom: 15px;">
                    <div class="col-6 text-right">
                        <strong style="font-size: 16px;">اسم المندوب:</strong>
                        <span t-esc="user_id" style="font-size: 16px; color: #555;"/>
                    </div>
                    <div class="col-6 text-right">
                        <strong style="font-size: 16px;">اليوم:</strong>
                        <span t-esc="date_order" style="font-size: 16px; color: #555;"/>
                    </div>
                </div>

                <div class="row" style="margin-bottom: 15px;">
                    <div class="col-12 text-right">
                        <strong style="font-size: 16px;">التاريخ:</strong>
                        <span t-esc="date_order2" style="font-size: 16px; color: #555;"/>
                    </div>
                </div>

                <!-- Table Section -->
                <table class="table table-bordered" style="width: 100%; border-collapse: collapse; border-spacing: 0; margin-top: 10px;">
    <thead>
        <tr style="background-color: #f8f9fa; border: 1px solid #ddd;">
            <th style="width: 15%; text-align: right; padding: 2px;">م</th>
            <th style="width: 15%; text-align: right; padding: 2px;">الصنف</th>
            <th style="width: 15%; text-align: right; padding: 2px;">الكمية</th>
        </tr>
    </thead>
    <tbody>
        <t t-set="iindex" t-value="1"/>
        <tr t-foreach="product_quantities" t-as="product">
            <td style="text-align: right; padding: 2px; border: 1px solid #ddd;">
                <t t-esc="iindex"/>
            </td>
            <td style="text-align: right; padding: 2px; border: 1px solid #ddd;">
                <t t-esc="product['product_id']"/>
            </td>
            <td style="text-align: right; padding: 2px; border: 1px solid #ddd;">
                <t t-esc="int(product['quantity'])"/>
            </td>
            <t t-set="iindex" t-value="iindex+1"/>
        </tr>
    </tbody>
</table>


                <!-- Total Section -->
                <div class="row" style="margin-top: 20px;">
                    <div class="col-12 text-right">
                        <strong style="font-size: 18px;">الإجمــالي:</strong>
                        <span t-esc="total" style="font-size: 18px; font-weight: bold; color: #d9534f;"/>
                    </div>
                </div>

            </div>
        </t>
    </t>
</template>
