<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <template id="report_sales_order_template">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page" dir="rtl">
                        <!-- Header Section -->
                        <center>
                            <h2>إذن صرف بضاعة</h2>
                        </center>
                        <div class="row">
                            <div class="row-12 text-right">
                                <strong>اسم المندوب:</strong>
                                <t t-esc="user_id"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="row-12 text-right">
                                <strong>اليوم:</strong>
                                <t t-esc="date_order"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="row-12 text-right">
                                <strong>التاريخ:</strong>
                                <t t-esc="date_order2"/>
                            </div>
                            </div>

                        <br/>
                        <br/>

                        <table class="table table-bordered" style="width: 100%;">
                            <thead>
                                <tr>
                                    <th>م</th>
                                    <th>الصنف</th>
                                    <th>الكمية</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Iterate through grouped product quantities -->
                                <t t-set="iindex" t-value="1"/>
                                <tr t-foreach="grouped_products_lst" t-as="product">
                                    <td>
                                        <t t-esc="iindex"/>
                                        <t t-set="iindex" t-value="iindex+1"/>
                                    </td>
                                    <td>
                                        <t t-esc="product['product_id']"/>
                                    </td>
                                    <td>
                                        <t t-esc="product['quantity']"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                         <div class="row">
                            <div class="row-12 text-right">
                                <strong>الإجمــالي:</strong>
                                <t t-esc="total"/>
                            </div>
                            </div>

                    </div>

                </t>
            </t>
        </template>
        <template id="report_stock_order_template">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page" dir="rtl">
                        <!-- Header Section -->
                        <center>
                            <h2>إذن صرف بضاعة</h2>
                        </center>
                        <div class="row">
                            <div class="row-12 text-right">
                                <strong>اسم المندوب:</strong>
                                <t t-esc="user_id"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="row-12 text-right">
                                <strong>اليوم:</strong>
                                <t t-esc="date_order"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="row-12 text-right">
                                <strong>التاريخ:</strong>
                                <t t-esc="date_order2"/>
                            </div>
                            </div>

                        <br/>
                        <br/>

                        <table class="table table-bordered" style="width: 100%;">
                            <thead>
                                <tr>
                                    <th>م</th>
                                    <th>الصنف</th>
                                    <th>الكمية</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Iterate through grouped product quantities -->
                                <t t-set="iindex" t-value="1"/>
                                <tr t-foreach="grouped_products_lst" t-as="product">
                                    <td>
                                        <t t-esc="iindex"/>
                                        <t t-set="iindex" t-value="iindex+1"/>
                                    </td>
                                    <td>
                                        <t t-esc="product['product_id']"/>
                                    </td>
                                    <td>
                                        <t t-esc="product['quantity']"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                         <div class="row">
                            <div class="row-12 text-right">
                                <strong>الإجمــالي:</strong>
                                <t t-esc="total"/>
                            </div>
                            </div>

                    </div>

                </t>
            </t>
        </template>


        <report
                id="action_report_sales_order"
                model="sale.order"
                string="إذن صرف بضاعة"
                report_type="qweb-pdf"
                name="user_analytic.report_sales_order_template"
                file="user_analytic.report_sales_order_template"
        />
        <report
                id="action_report_stock_order"
                model="stock.picking"
                string="إذن صرف بضاعة"
                report_type="qweb-pdf"
                name="user_analytic.report_stock_order_template"
                file="user_analytic.report_stock_order_template"
        />


    </data>
</odoo>


