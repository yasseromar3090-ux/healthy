<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_floor_wise_report_wizard_form_view" model="ir.ui.view">
        <field name="name">pos.floor.wise.report.wizard.form.view</field>
        <field name="model">pos.floor.wise.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Floor wise sales summary">
                <p>
                </p>
                <group>
                    <group>
                        <field name='start_date' />
                        <field name="pos_id"/>
                    </group>
                    <group>
                        <field name='end_date' />
                    </group>
                </group>
                <group string="Floors">
                    <field name='floor_ids' nolabel="1" domain="[('pos_config_id', '=', pos_id)]"/>
                </group>
                <footer>
                    <button name="action_print_report" string="Print"
                        type="object" default_focus="1" class="oe_highlight" />
                    or
                    <button string="Cancel" class="oe_link"
                        special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_pos_floor_wise_report_wizard">
        <field name="name">Floor wise sales summary</field>
        <field name="res_model">pos.floor.wise.report.wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_type">form</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="pos_floor_wise_report_wizard_form_view" />
        <field name="target">new</field>
    </record>

    <menuitem id="menu_floor_wise_report" name="Floor wise sales summary"
        action="action_pos_floor_wise_report_wizard" parent="point_of_sale.menu_point_rep"
        sequence="10" />

</odoo>
